# Copy to .env.local (local) or set these in your host's environment settings (Vercel).
DATABASE_URL=postgresql://user:password@host/dbname
# First-time setup only: 20+ random characters. You type it once on the setup screen, then you can remove it.
OWNER_SETUP_TOKEN=
# Decides what "today" means (IANA name). Optional; can also be set on the Today screen.
SALES_TIMEZONE=America/Jamaica
